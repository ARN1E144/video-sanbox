{
  "name": "VideoFeed",
  "type": "video",
  "category": "media",
  "icon": "📹",

  "editableProps": {
  "mode": {
    "type": "select",
    "label": "Mode",
    "default": "local",
    "group": "source",
    "options": [
      { "value": "local", "label": "Local Camera" },
      { "value": "remote", "label": "Remote / URL" }
    ]
  },

  "src": {
    "type": "string",
    "label": "Video Source (URL)",
    "placeholder": "https://example.com/video.mp4",
    "group": "source",
    "visibleWhen": { "mode": "remote" }
  },

  "deviceId": {
    "type": "string",
    "label": "Camera Device ID",
    "group": "source",
    "visibleWhen": { "mode": "local" }
  },

  "enabled": {
    "type": "boolean",
    "label": "Enabled",
    "default": true,
    "group": "playback"
  },

  "playing": {
    "type": "boolean",
    "label": "Playing",
    "default": true,
    "group": "playback"
  },

  "muted": {
    "type": "boolean",
    "label": "Muted",
    "default": true,
    "group": "playback"
  },

  "mirror": {
    "type": "boolean",
    "label": "Mirror Video",
    "default": true,
    "group": "display",
    "visibleWhen": { "mode": "local" }
  },

  "poster": {
    "type": "string",
    "label": "Poster Image",
    "group": "display",
    "placeholder": "https://example.com/poster.jpg"
  },

  "showSpinner": {
    "type": "boolean",
    "label": "Show Loading Spinner",
    "group": "display",
    "default": true
  },

  "objectFit": {
    "type": "select",
    "label": "Object Fit",
    "group": "display",
    "default": "cover",
    "options": [
      { "value": "cover", "label": "Cover" },
      { "value": "contain", "label": "Contain" },
      { "value": "fill", "label": "Fill" }
    ]
  },

  "borderRadius": {
    "type": "number",
    "label": "Border Radius",
    "group": "style",
    "default": 12
  },

  "style": {
    "type": "style",
    "label": "Style",
    "group": "style",
    "default": {
      "backgroundColor": "#000000"
    }
  }
},

  "actions": [
  { "value": "video.startStream", "label": "Start Video Stream" },
  { "value": "video.stopStream", "label": "Stop Video Stream" },
  { "value": "video.togglePlay", "label": "Toggle Play / Pause" },
  { "value": "video.loadRemote", "label": "Load Remote Video" },
  { "value": "video.captureFrame", "label": "Capture Frame" },
  { "value": "custom", "label": "Custom JS" }
],

  "conditions": [
    { "value": "isEnabled", "label": "Is Enabled" },
    { "value": "isPlaying", "label": "Is Playing" },
    { "value": "hasSource", "label": "Has Video Source" },
    { "value": "isRemote", "label": "Mode Is Remote" }
  ]
}
