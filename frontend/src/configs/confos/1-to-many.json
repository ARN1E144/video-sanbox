{

  "id": "confo.one_to_many",
  "name": "1-to-Many Video Call",
  "version": 1,
  "type": "confo",
  "description": "One client connects, multiple users alerted, first to accept joins",

    "capabilities": [
      "video",
      "audio",
      "remoteUsers",
      "multiParticipant"
    ],
  "elements": [
    {
      "type": "AgoraFeed",
      "id": "agora_client",
      "props": {
        "channel": "{{call.channel}}",
        "autoJoin": false,
        "publishLocal": true,
        "muted": false,
        "cameraOff": false,
        "mirror": true,
        "objectFit": "cover",
        "borderRadius": 12,
        "style": { "backgroundColor": "#000000" }
      },
      "actions": [
        { "name": "call.fetchAvailableCalls", "trigger": "click" },
        { "name": "call.acceptCall", "trigger": "click" },
        { "name": "call.endCall", "trigger": "click" },
        { "name": "call.toggleMic", "trigger": "click" },
        { "name": "call.toggleVideo", "trigger": "click" }
      ]
    }
  ]
}