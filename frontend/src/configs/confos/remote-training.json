{
  "id": "confo.remote_training",
  "name": "Remote Training",
  "version": 1,
  "type": "confo",
  "description": "Host-led remote training with live video, controls and chat.",
  "tree": {
    "id": "root",
    "type": "Container",
    "props": {
      "layout": "vertical",
      "backgroundColor": "#181818"
    },
    "children": [
      {
        "id": "training-header",
        "type": "TextLabel",
        "props": {
          "label": "Remote Training",
          "style": {
            "color": "#FFFFFF",
            "fontSize": "24px"
          }
        }
      },
      {
        "id": "training-video",
        "type": "AgoraFeed",
        "props": {
          "channel": "{{call.channel}}",
          "autoJoin": true,
          "publishLocal": true,
          "muted": false,
          "cameraOff": false,
          "mirror": true,
          "objectFit": "cover",
          "borderRadius": 12,
          "style": {
            "backgroundColor": "#000000"
          }
        }
      },
      {
        "id": "training-mic",
        "type": "ControlButton",
        "props": {
          "label": "Toggle Mic",
          "action": "call.toggleMic",
          "targetId": "training-video"
        }
      },
      {
        "id": "training-video-toggle",
        "type": "ControlButton",
        "props": {
          "label": "Toggle Camera",
          "action": "call.toggleVideo",
          "targetId": "training-video"
        }
      },
     {
        "id": "training-start",
        "type": "ControlButton",
        "props": {
          "label": "Start Training",
          "action": "call.startCall",
          "targetId": "training-video"
        }
      },
      {
        "id": "end-training",
        "type": "ControlButton",
        "x": 980,
        "y": 570,
        "width": 180,
        "height": 50,
        "props": {
          "label": "End Training",
          "action": "call.endCall"
        }
      },
      {
        "id": "training-chat",
        "type": "ChatPanel",
        "x": 980,
        "y": 100,
        "width": 300,
        "height": 400,
        "props": {}
      }
    ]
  }
}