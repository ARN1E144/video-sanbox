{
  "id": "test.compliance",
  "name": "Compliance Test",
  "version": 1,
  "type": "confo",

  "capabilities": [
    "compliance"
  ],

  "runtime": {
    "triggers": [
      {
        "id": "analyse-uploaded-evidence",
        "name": "Analyse uploaded evidence",
        "event": "compliance.evidenceUploaded",

        "condition": {
          "source": "payload",
          "path": "evidenceId",
          "operator": "exists"
        },

        "actions": [
          "compliance.analyseEvidence"
        ]
      }
    ]
  },

  "tree": {
    "id": "compliance-root",
    "type": "Container",

    "props": {
      "layout": "vertical"
    },

    "children": [

      {
        "id": "compliance-title",
        "type": "TextLabel",

        "props": {
          "label": "ISO 27001 Compliance"
        }
      },

      {
        "id": "compliance-actions",
        "type": "ControlPanel",

        "props": {
          "layout": "horizontal",
          "gap": 12
        },

        "children": [

          {
            "id": "compliance-load",
            "type": "ControlButton",

            "props": {
              "label": "Load Compliance",
              "action": "compliance.load"
            }
          },

          {
            "id": "compliance-request-evidence",
            "type": "ControlButton",
            "props": {
              "label": "Request Evidence",
              "action": "compliance.requestEvidence",
              "params": {
                "controlId": {
                  "$state": "compliance.selectedControlId"
                }
              }
            }
          }

        ]
      },

      {
        "id": "compliance-control-panel",
        "type": "ControlPanel",

        "props": {
          "layout": "horizontal",
          "gap": 12
        },

        "children": [

          {
            "id": "compliance-control-select",
            "type": "Select",

            "props": {
              "label": "Control",
              "bindTo": "compliance.selectedControlId",
              "placeholder": "Select a control",

              "options": [
                {
                  "value": "a-5.1",
                  "label": "A.5.1 — Policies for information security"
                },
                {
                  "value": "a-5.2",
                  "label": "A.5.2 — Information security roles and responsibilities"
                },
                {
                  "value": "a-5.3",
                  "label": "A.5.3 — Segregation of duties"
                },
                {
                  "value": "a-5.4",
                  "label": "A.5.4 — Management responsibilities"
                }
              ]
            }
          }

        ]
      },

      {
        "id": "compliance-upload",
        "type": "FileUpload",
        "props": {
          "label": "Upload Evidence",
          "accept": ".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg",
          "multiple": false,
          "bindTo": "compliance.selectedEvidenceFile",
          "action": "compliance.uploadEvidence",
          "params": {
            "evidenceId": {
              "$state": "compliance.selectedEvidenceId"
            }
          }
        }
      },

      {
        "id": "compliance-evidence",
        "type": "ComplianceEvidence",

        "props": {
          "showStatus": true,
          "showAssessment": true,
          "showActions": true
        }
      }

    ]
  }
}