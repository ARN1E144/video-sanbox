{
  "id": "test.compliance",
  "name": "Compliance Test",
  "version": 1,
  "type": "confo",

  "capabilities": [
    "compliance"
  ],

  "runtime": {
    "triggers": [
      {
        "id": "analyse-uploaded-evidence",
        "name": "Analyse uploaded evidence",
        "event": "compliance.evidenceUploaded",

        "condition": {
          "source": "payload",
          "path": "evidenceId",
          "operator": "exists"
        },

        "actions": [
          "compliance.analyseEvidence"
        ]
      }
    ]
  },

  "tree": {
    "id": "compliance-root",
    "type": "Container",

    "props": {
      "layout": "vertical"
    },

    "children": [

      {
        "id": "compliance-title",
        "type": "TextLabel",

        "props": {
          "label": "ISO 27001 Compliance"
        }
      },

      {
        "id": "compliance-evidence",
        "type": "ComplianceEvidence",

        "props": {}
      }

    ]
  }
}