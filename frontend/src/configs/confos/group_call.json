{
"id": "confo.group_call",
"name": "Group Video Call",
"version": 4,
"type": "confo",
"description": "Live multi-participant video calling with participant selection, invitations, re-invitations and runtime-driven media.",

"capabilities": [
"video",
"audio",
"group-call",
"invitations",
"realtime",
"multi-participant"
],

"tree": {
"id": "group-call-root",
"type": "Container",
"role": null,

"x": 0,
"y": 0,
"width": 1440,
"height": 900,

"props": {
  "layout": "free",
  "padding": 0,
  "gap": 0,

  "style": {
    "backgroundColor": "#0f172a"
  }
},

"children": [

  {
    "id": "group-call-header",
    "type": "TextLabel",
    "role": null,

    "x": 0,
    "y": 0,
    "width": 300,
    "height": 40,

    "props": {
      "label": "Group Video Call"
    }
  },

  {
    "id": "group-call-participants",
    "type": "ParticipantSelector",
    "role": null,

    "x": 0,
    "y": 0,
    "width": 620,
    "height": 180,

    "props": {
      "label": "Invite Participants",
      "placeholder": "Select participants...",
      "multiple": true,
      "selectionPath": "call.selectedParticipantIds"
    }
  },

  {
    "id": "group-call-controls",
    "type": "ControlPanel",
    "role": null,

    "x": 0,
    "y": 0,
    "width": 760,
    "height": 96,

    "props": {
      "layout": "horizontal"
    },

    "children": [

      {
        "id": "group-call-start",
        "type": "ControlButton",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 120,
        "height": 38,

        "props": {
          "label": "Start Group Call",
          "action": "call.createGroupCall"
        }
      },

      {
        "id": "group-call-invite",
        "type": "ControlButton",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 120,
        "height": 38,

        "props": {
          "label": "Invite / Re-invite",
          "action": "call.inviteGroupParticipants"
        }
      },

      {
        "id": "group-call-leave",
        "type": "ControlButton",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 120,
        "height": 38,

        "props": {
          "label": "Leave Call",
          "action": "call.leaveGroupCall"
        }
      },

      {
        "id": "group-call-end",
        "type": "ControlButton",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 120,
        "height": 38,

        "props": {
          "label": "End Group Call",
          "action": "call.endGroupCall"
        }
      },

      {
        "id": "group-call-mic",
        "type": "ControlButton",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 120,
        "height": 38,

        "props": {
          "label": "Toggle Mic",
          "action": "call.toggleMic"
        }
      },

      {
        "id": "group-call-video",
        "type": "ControlButton",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 120,
        "height": 38,

        "props": {
          "label": "Toggle Video",
          "action": "call.toggleVideo"
        }
      }

    ]
  },

  {
    "id": "group-call-local-video",
    "type": "AgoraFeed",
    "role": null,

    "x": 0,
    "y": 0,
    "width": 800,
    "height": 450,

    "props": {
      "localLayout": "full",
      "publishLocal": true,
      "autoJoin": false,
      "mirror": true,
      "objectFit": "cover",
      "borderRadius": 12
    }
  },

  {
    "id": "group-call-remote-grid",
    "type": "RemoteVideoGrid",
    "role": null,

    "x": 0,
    "y": 0,
    "width": 800,
    "height": 300,

    "props": {
      "source": "call.remoteUsers",
      "columns": 2,
      "gap": 8,
      "emptyText": "Waiting for participants..."
    }
  },

  {
    "id": "group-call-client-section",
    "type": "Container",
    "role": null,

    "x": 0,
    "y": 0,
    "width": 760,
    "height": 300,

    "props": {
      "layout": "vertical",
      "padding": 12,
      "gap": 8,
      "collapsible": true,
      "defaultCollapsed": false,
      "label": "Client Calls",

      "style": {
        "backgroundColor": "#111827",
        "borderRadius": 12
      }
    },

    "children": [

      {
        "id": "group-call-client-header",
        "type": "TextLabel",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 300,
        "height": 40,

        "props": {
          "label": "Incoming Group Calls"
        }
      },

      {
        "id": "group-call-client-alert",
        "type": "IncomingGroupCallAlert",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 720,
        "height": 80,

        "props": {
          "source": "calls.pendingInvitations"
        }
      },

      {
        "id": "group-call-client-actions",
        "type": "ControlPanel",
        "role": null,

        "x": 0,
        "y": 0,
        "width": 720,
        "height": 96,

        "props": {
          "layout": "horizontal"
        },

        "children": [

          {
            "id": "group-call-client-refresh",
            "type": "ControlButton",
            "role": null,

            "x": 0,
            "y": 0,
            "width": 120,
            "height": 38,

            "props": {
              "label": "Refresh Invitations",
              "action": "call.fetchPendingInvitations"
            }
          },

          {
            "id": "group-call-client-accept",
            "type": "ControlButton",
            "role": null,

            "x": 0,
            "y": 0,
            "width": 120,
            "height": 38,

            "props": {
              "label": "Accept Invitation",
              "action": "call.acceptInvitation"
            }
          },

          {
            "id": "group-call-client-decline",
            "type": "ControlButton",
            "role": null,

            "x": 0,
            "y": 0,
            "width": 120,
            "height": 38,

            "props": {
              "label": "Decline Invitation",
              "action": "call.declineInvitation"
            }
          },

          {
            "id": "group-call-client-join",
            "type": "ControlButton",
            "role": null,

            "x": 0,
            "y": 0,
            "width": 120,
            "height": 38,

            "props": {
              "label": "Join Group Call",
              "action": "call.joinGroupCall"
            }
          }

        ]
      }

    ]
  }

]

}
}
