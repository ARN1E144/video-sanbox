{
"id": "confo.chat_test",
"name": "Chat Test",
"version": 1,
"type": "confo",
"description": "Runtime chat test application for project-scoped conversations, conversation invitations, realtime messaging and chat lifecycle.",
"capabilities": [
"chat"
],
"tree": {
"id": "chat-test-root",
"type": "Container",
"width": 1440,
"height": 900,
"props": {
"layout": "vertical",
"style": {
"width": "100%",
"height": "100%",
"padding": 20,
"gap": 12,
"backgroundColor": "#111",
"boxSizing": "border-box",
"overflow": "auto"
}
},
"children": [
{
"id": "chat-test-title",
"type": "TextLabel",
"props": {
"text": "Chat Test",
"style": {
"fontSize": 20,
"fontWeight": 700,
"color": "#fff"
}
}
},
{
"id": "chat-test-description",
"type": "TextLabel",
"props": {
"text": "Create or select a conversation, manage invitations, then test realtime messaging.",
"style": {
"fontSize": 11,
"color": "#777"
}
}
},
{
"id": "chat-test-create-section",
"type": "Container",
"props": {
"layout": "vertical",
"style": {
"width": "100%",
"padding": 12,
"gap": 8,
"backgroundColor": "#151515",
"border": "1px solid #292929",
"borderRadius": 8,
"boxSizing": "border-box",
"flexShrink": 0
}
},
"children": [
{
"id": "chat-test-create-label",
"type": "TextLabel",
"props": {
"text": "Create conversation",
"style": {
"fontSize": 13,
"fontWeight": 700,
"color": "#fff"
}
}
},
{
"id": "chat-test-title-input",
"type": "TextBox",
"props": {
"placeholder": "Conversation title...",
"bindTo": "chat.create.title",
"style": {
"width": "100%"
}
}
},
{
"id": "chat-test-participants",
"type": "ParticipantSelector",
"props": {
  "selectionPath": "chat.create.participantIds",
  "multiple": true,
  "placeholder": "Select participants...",
  "style": {
    "width": "100%",
    "minHeight": 44
  }
}
},
{
"id": "chat-test-create-button",
"type": "ControlButton",
"props": {
"label": "Create Conversation",
"action": "chat.createConversation",
"params": {
"title": "{{chat.create.title}}",
"participantIds": "{{chat.create.participantIds}}"
}
}
}
]
},
{
"id": "chat-test-conversation-section",
"type": "Container",
"props": {
"layout": "horizontal",
"style": {
"width": "100%",
"gap": 8,
"alignItems": "center",
"boxSizing": "border-box",
"flexShrink": 0
}
},
"children": [
{
"id": "chat-test-conversation-select",
"type": "Select",
"props": {
 "bindTo": "chat.conversationId",
  "options": "{{chat.conversations}}",
  "placeholder": "Select conversation...",
  "style": {
    "flex": 1,
    "minWidth": 0
  }
}
},
{
"id": "chat-test-load-conversations",
"type": "ControlButton",
"props": {
"label": "Load Conversations",
"action": "chat.loadConversations"
}
}
]
},
{
"id": "chat-test-conversation-list-section",
"type": "Container",
"props": {
"layout": "vertical",
"style": {
"width": "100%",
"height": 180,
"minHeight": 180,
"maxHeight": 180,
"padding": 8,
"gap": 6,
"backgroundColor": "#151515",
"border": "1px solid #292929",
"borderRadius": 8,
"boxSizing": "border-box",
"overflow": "auto",
"flexShrink": 0
}
},
"children": [
{
"id": "chat-test-conversation-list",
"type": "ConversationList",
"props": {
"title": "Conversations & Invitations",
"style": {
"width": "100%"
}
}
}
]
},
{
"id": "chat-test-invitation-actions",
"type": "Container",
"props": {
"layout": "horizontal",
"style": {
"width": "100%",
"gap": 8,
"alignItems": "center",
"flexWrap": "wrap",
"boxSizing": "border-box",
"flexShrink": 0
}
},
"children": [
{
"id": "chat-test-accept",
"type": "ControlButton",
"props": {
"label": "Accept Invitation",
"action": "chat.acceptConversationInvitation",
"params": {
"conversationId": "{{chat.conversationId}}"
}
}
},
{
"id": "chat-test-decline",
"type": "ControlButton",
"props": {
"label": "Decline Invitation",
"action": "chat.declineConversationInvitation",
"params": {
"conversationId": "{{chat.conversationId}}"
}
}
}
]
},
{
"id": "chat-test-actions",
"type": "Container",
"props": {
"layout": "horizontal",
"style": {
"width": "100%",
"gap": 8,
"alignItems": "center",
"flexWrap": "wrap",
"boxSizing": "border-box",
"flexShrink": 0
}
},
"children": [
{
"id": "chat-test-join",
"type": "ControlButton",
"props": {
"label": "Join Chat",
"action": "chat.joinConversation",
"params": {
"conversationId": "{{chat.conversationId}}"
}
}
},
{
"id": "chat-test-load",
"type": "ControlButton",
"props": {
"label": "Load Messages",
"action": "chat.loadMessages",
"params": {
"conversationId": "{{chat.conversationId}}"
}
}
},
{
"id": "chat-test-leave",
"type": "ControlButton",
"props": {
"label": "Leave Chat",
"action": "chat.leaveConversation",
"params": {
"conversationId": "{{chat.conversationId}}"
}
}
},
{
"id": "chat-test-close",
"type": "ControlButton",
"props": {
"label": "Close Conversation",
"action": "chat.closeConversation",
"params": {
"conversationId": "{{chat.conversationId}}"
}
}
}
]
},
{
"id": "chat-test-panel-container",
"type": "Container",
"props": {
"layout": "vertical",
"style": {
"width": "100%",
"flex": 1,
"minHeight": 0,
"minWidth": 0,
"backgroundColor": "#151515",
"border": "1px solid #292929",
"borderRadius": 8,
"padding": 8,
"boxSizing": "border-box",
"overflow": "hidden"
}
},
"children": [
{
"id": "chat-test-panel",
"type": "ChatPanel",
"props": {
"bindKey": "chat.messages",
"conversationIdBindKey": "chat.conversationId",
"title": "Chat",
"style": {
"width": "100%",
"height": "100%",
"minHeight": 0,
"minWidth": 0,
"backgroundColor": "#181818",
"color": "#fff",
"borderRadius": 6,
"boxSizing": "border-box"
}
}
}
]
},
{
"id": "chat-test-input-row",
"type": "Container",
"props": {
"layout": "horizontal",
"style": {
"width": "100%",
"gap": 8,
"alignItems": "center",
"boxSizing": "border-box",
"flexShrink": 0
}
},
"children": [
{
"id": "chat-test-input",
"type": "TextBox",
"props": {
"placeholder": "Type a message...",
"bindTo": "chat.input",
"style": {
"flex": 1,
"minWidth": 0
}
}
},
{
"id": "chat-test-send",
"type": "ControlButton",
"props": {
"label": "Send",
"action": "chat.sendMessage",
"params": {
"conversationId": "{{chat.conversationId}}",
"text": "{{chat.input}}"
}
}
}
]
}
]
}
}
