
{
  "id": "confo.chat_test",
  "name": "Chat Test",
  "version": 1,
  "type": "confo",
  "description": "Runtime chat test application for project-scoped conversations, invitations and realtime messaging.",
  "capabilities": [
    "chat"
  ],
  "tree": {
    "id": "chat-test-root",
    "type": "Container",
    "width": 1440,
    "height": 900,
    "props": {
      "layout": "vertical",
      "style": {
        "width": "100%",
        "height": "100%",
        "padding": 20,
        "gap": 12,
        "backgroundColor": "#111",
        "boxSizing": "border-box",
        "overflow": "hidden"
      }
    },
    "children": [
      {
        "id": "chat-test-title",
        "type": "TextLabel",
        "props": {
          "text": "Chat Test",
          "style": {
            "fontSize": 20,
            "fontWeight": 700,
            "color": "#fff"
          }
        }
      },
      {
        "id": "chat-test-description",
        "type": "TextLabel",
        "props": {
          "text": "Create conversations, manage invitations and test realtime messaging.",
          "style": {
            "fontSize": 11,
            "color": "#777"
          }
        }
      },
      {
        "id": "chat-test-create-section",
        "type": "Container",
        "props": {
          "layout": "vertical",
          "style": {
            "width": "100%",
            "padding": 12,
            "gap": 8,
            "backgroundColor": "#151515",
            "border": "1px solid #292929",
            "borderRadius": 8,
            "boxSizing": "border-box",
            "flexShrink": 0
          }
        },
        "children": [
          {
            "id": "chat-test-create-label",
            "type": "TextLabel",
            "props": {
              "text": "Create conversation",
              "style": {
                "fontSize": 12,
                "fontWeight": 700,
                "color": "#fff"
              }
            }
          },
          {
            "id": "chat-test-create-fields",
            "type": "Container",
            "props": {
              "layout": "horizontal",
              "style": {
                "width": "100%",
                "gap": 8,
                "alignItems": "center",
                "boxSizing": "border-box"
              }
            },
            "children": [
              {
                "id": "chat-test-title-input",
                "type": "TextBox",
                "props": {
                  "placeholder": "Conversation title...",
                  "bindTo": "chat.create.title",
                  "style": {
                    "flex": 1,
                    "minWidth": 120
                  }
                }
              },
              {
                "id": "chat-test-participants",
                "type": "ParticipantSelector",
                "props": {
                  "selectionPath": "chat.create.participantIds",
                  "multiple": true,
                  "placeholder": "Select participants...",
                  "style": {
                    "flex": 2,
                    "minWidth": 180,
                    "minHeight": 44
                  }
                }
              },
              {
                "id": "chat-test-create-button",
                "type": "ControlButton",
                "props": {
                  "label": "Create Conversation",
                  "action": "chat.createConversation",
                  "params": {
                    "title": "{{chat.create.title}}",
                    "participantIds": "{{chat.create.participantIds}}"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "id": "chat-test-workspace",
        "type": "Container",
        "props": {
          "layout": "horizontal",
          "style": {
            "width": "100%",
            "flex": 1,
            "minHeight": 0,
            "minWidth": 0,
            "gap": 12,
            "alignItems": "stretch",
            "boxSizing": "border-box",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "id": "chat-test-sidebar",
            "type": "Container",
            "props": {
              "layout": "vertical",
              "style": {
                "width": 340,
                "minWidth": 300,
                "flexShrink": 0,
                "minHeight": 0,
                "padding": 10,
                "gap": 10,
                "backgroundColor": "#151515",
                "border": "1px solid #292929",
                "borderRadius": 8,
                "boxSizing": "border-box",
                "overflow": "hidden"
              }
            },
            "children": [
              {
                "id": "chat-test-sidebar-heading",
                "type": "TextLabel",
                "props": {
                  "text": "Conversations",
                  "style": {
                    "fontSize": 13,
                    "fontWeight": 700,
                    "color": "#fff"
                  }
                }
              },
              {
                "id": "chat-test-conversation-section",
                "type": "Container",
                "props": {
                  "layout": "horizontal",
                  "style": {
                    "width": "100%",
                    "gap": 6,
                    "alignItems": "center",
                    "flexShrink": 0,
                    "boxSizing": "border-box"
                  }
                },
                "children": [
                  {
                    "id": "chat-test-conversation-select",
                    "type": "Select",
                    "props": {
                      "bindTo": "chat.conversationId",
                      "options": "{{chat.conversations}}",
                      "placeholder": "Select conversation...",
                      "style": {
                        "flex": 1,
                        "minWidth": 0
                      }
                    }
                  },
                  {
                    "id": "chat-test-load-conversations",
                    "type": "ControlButton",
                    "props": {
                      "label": "Load",
                      "action": "chat.loadConversations"
                    }
                  }
                ]
              },
              {
                "id": "chat-test-conversation-list-section",
                "type": "Container",
                "props": {
                  "layout": "vertical",
                  "style": {
                    "width": "100%",
                    "flex": 1,
                    "minHeight": 180,
                    "minWidth": 0,
                    "padding": 8,
                    "gap": 6,
                    "backgroundColor": "#111",
                    "border": "1px solid #292929",
                    "borderRadius": 6,
                    "boxSizing": "border-box",
                    "overflow": "auto"
                  }
                },
                "children": [
                  {
                    "id": "chat-test-conversation-list",
                    "type": "ConversationList",
                    "props": {
                      "title": "Conversations & Invitations",
                      "style": {
                        "width": "100%"
                      }
                    }
                  }
                ]
              },
              {
                "id": "chat-test-invitation-actions",
                "type": "Container",
                "props": {
                  "layout": "horizontal",
                  "style": {
                    "width": "100%",
                    "gap": 6,
                    "alignItems": "center",
                    "flexWrap": "wrap",
                    "flexShrink": 0,
                    "boxSizing": "border-box"
                  }
                },
                "children": [
                  {
                    "id": "chat-test-accept",
                    "type": "ControlButton",
                    "props": {
                      "label": "Accept Invitation",
                      "action": "chat.acceptConversationInvitation",
                      "params": {
                        "conversationId": "{{chat.conversationId}}"
                      }
                    }
                  },
                  {
                    "id": "chat-test-decline",
                    "type": "ControlButton",
                    "props": {
                      "label": "Decline",
                      "action": "chat.declineConversationInvitation",
                      "params": {
                        "conversationId": "{{chat.conversationId}}"
                      }
                    }
                  }
                ]
              },
              {
                "id": "chat-test-actions",
                "type": "Container",
                "props": {
                  "layout": "horizontal",
                  "style": {
                    "width": "100%",
                    "gap": 6,
                    "alignItems": "center",
                    "flexWrap": "wrap",
                    "flexShrink": 0,
                    "boxSizing": "border-box"
                  }
                },
                "children": [
                  {
                    "id": "chat-test-join",
                    "type": "ControlButton",
                    "props": {
                      "label": "Join Chat",
                      "action": "chat.joinConversation",
                      "params": {
                        "conversationId": "{{chat.conversationId}}"
                      }
                    }
                  },
                  {
                    "id": "chat-test-load",
                    "type": "ControlButton",
                    "props": {
                      "label": "Load Messages",
                      "action": "chat.loadMessages",
                      "params": {
                        "conversationId": "{{chat.conversationId}}"
                      }
                    }
                  },
                  {
                    "id": "chat-test-leave",
                    "type": "ControlButton",
                    "props": {
                      "label": "Leave",
                      "action": "chat.leaveConversation",
                      "params": {
                        "conversationId": "{{chat.conversationId}}"
                      }
                    }
                  },
                  {
                    "id": "chat-test-close",
                    "type": "ControlButton",
                    "props": {
                      "label": "Close",
                      "action": "chat.closeConversation",
                      "params": {
                        "conversationId": "{{chat.conversationId}}"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "chat-test-panel-container",
            "type": "Container",
            "props": {
              "layout": "vertical",
              "style": {
                "width": "100%",
                "flex": 1,
                "minHeight": 0,
                "minWidth": 0,
                "backgroundColor": "#151515",
                "border": "1px solid #292929",
                "borderRadius": 8,
                "padding": 8,
                "boxSizing": "border-box",
                "overflow": "hidden"
              }
            },
            "children": [
              {
                "id": "chat-test-panel",
                "type": "ChatPanel",
                "props": {
                  "bindKey": "chat.messages",
                  "conversationIdBindKey": "chat.conversationId",
                  "title": "Chat",
                  "style": {
                    "width": "100%",
                    "height": "100%",
                    "minHeight": 0,
                    "minWidth": 0,
                    "backgroundColor": "#181818",
                    "color": "#fff",
                    "borderRadius": 6,
                    "boxSizing": "border-box"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
